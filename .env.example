# Nothing is needed to run the desktop app, the mobile web app or the tests.
# These are only for building the Android app (see docs/ANDROID.md). Placeholders only.
JAVA_HOME=/path/to/jdk-21
ANDROID_HOME=/path/to/android-sdk
# .properties file with storeFile, storePassword, keyAlias, keyPassword – kept outside the repository
NALOGIX_SIGNING=/path/outside/the/repo/nalogix-release.properties
